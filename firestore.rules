rules_version = '2';

// 合言葉（同期コード）方式。
// 予定は trips/{合言葉}/items に入れるので、合言葉を知らない人はパスを当てられない＝読めない。
//
// ↓の 'ここに合言葉' は、実際にFirebaseコンソールへ貼る際に本物の文字列へ置き換えること。
// 本物は 合言葉.txt（Git管理外）に控えてある。このファイルは公開リポジトリに載るので書かない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripCode}/{document=**} {
      allow read, write: if tripCode == 'ここに合言葉';
    }
  }
}
